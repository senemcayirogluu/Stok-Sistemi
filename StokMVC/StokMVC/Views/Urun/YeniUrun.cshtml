@model StokMVC.Models.Entity.TblUrunler
@{
    ViewBag.Title = "YeniUrun";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<form method="post">
    <h2>Yeni Ürün Ekleme</h2>
    @Html.HiddenFor(x => x.id, new { @class = "form-control" })
    <br />
    <label style="margin-top:15px">Ürün Adı Giriniz: </label>
    @Html.TextBoxFor(x => x.ad, new { @class = "form-control" })
    <label style="margin-top:15px">Marka Giriniz: </label>
    @Html.TextBoxFor(x => x.marka, new { @class = "form-control" })
    <label style="margin-top:15px">Stok Durumu Giriniz: </label>
    @Html.TextBoxFor(x => x.stok, new { @class = "form-control" })
    <label style="margin-top:15px">Alış Fiyatı Giriniz: </label>
    @Html.TextBoxFor(x => x.alisfiyat, new { @class = "form-control" })
    <label style="margin-top:15px">Satış Fiyatı Giriniz: </label>
    @Html.TextBoxFor(x => x.satisfiyat, new { @class = "form-control" })
    <label style="margin-top:15px">Kategori Seçiniz: </label>
    @Html.DropDownListFor(x => x.TblKategori.id, (List<SelectListItem>)ViewBag.drop, new { @class = "form-control" })
    <button class="btn btn-success" style="margin-top:15px">Ürün Ekle</button>
</form>