@model StokMVC.Models.Entity.TblMusteri
@{
    ViewBag.Title = "MusteriGetir";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@using (Html.BeginForm("MusteriGuncelle", "Musteri", FormMethod.Post))
{
    <h2>Müşteri Güncelleme</h2>
    @Html.HiddenFor(x => x.id, new { @class = "form-control" })
    <br />
    <label style="margin-top:15px">Müşteri Adı Giriniz: </label>
    @Html.TextBoxFor(x => x.ad, new { @class = "form-control" })
    <label style="margin-top:15px">Müşteri Soyadı Giriniz: </label>
    @Html.TextBoxFor(x => x.soyad, new { @class = "form-control" })
    <label style="margin-top:15px">Şehir Giriniz: </label>
    @Html.TextBoxFor(x => x.sehir, new { @class = "form-control" })
    <label style="margin-top:15px">Bakiye Giriniz: </label>
    @Html.TextBoxFor(x => x.bakiye, new { @class = "form-control" })
    <button class="btn btn-info" style="margin-top:15px">Güncelle</button>

}

